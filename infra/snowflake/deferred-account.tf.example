# NOT ACTIVE: provider 2.21.0 does not read resource_monitor into account state.
# More privilege does not make this an import-only or drift-detecting resource.
# Preserve the correct ACCOUNT-level binding; see docs/snowflake-adoption-gap.md.
# A same-value ALTER requires a separate owner decision and ACCOUNTADMIN execution.
# The current_account provider also warns that CREATE unsets unrelated account
# parameters: an eventual import must be mandatory, never a create fallback.
resource "snowflake_current_account" "budget_attachment" {
  resource_monitor = snowflake_resource_monitor.budget.name
  lifecycle {
    prevent_destroy = true
    # The project's monitor attachment does not own unrelated account policies.
    ignore_changes = [
      cortex_enabled_cross_region, authentication_policy, password_policy,
      session_policy, network_policy, packages_policy, feature_policy,
    ]
  }
}
import {
  to = snowflake_current_account.budget_attachment
  id = "current_account"
}
