              "Variable": "$.stage.mode",
              "StringEquals": "publish"
            },
            {
              "Variable": "$.stage.request_id",
              "StringEqualsPath": "$.run.request_id"
            },
            {
              "Variable": "$.stage.target",
              "StringEqualsPath": "$.run.target"
            }
          ],
          "Next": "publishAdvance"
        }
      ],
      "Default": "Uncertain"
    },
    "publishAdvance": {
      "Type": "Pass",
      "InputPath": "$.stage",
      "End": true
    },
    "admitOutcome": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.stage.reused",
          "BooleanEquals": true,
          "Next": "ReplayComplete"
        }
      ],
      "Default": "admitAdvance"
    },
    "ReplayComplete": {
      "Type": "Pass",
      "InputPath": "$.stage",
      "End": true
    },
    "Uncertain": {
      "Type": "Fail",
      "Error": "RECOVERY_REQUIRED",
      "Cause": "No retry/takeover: reconcile this execution, task and query evidence"
    },
    "Initialize": {
      "Type": "Pass",
      "Next": "admitCompose",
      "Parameters": {
        "run.$": "$.run",
        "budget.$": "$.run.budget",
        "authority": null,
        "dependency": null
      }
    }
  }
}
