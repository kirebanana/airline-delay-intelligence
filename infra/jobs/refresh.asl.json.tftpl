        "request.$": "$.request",
        "control.$": "$.control",
        "inputs_expected.$": "$.inputs_expected",
        "inputs_actual.$": "$.control.inputs_sha256",
        "expected_report.$": "States.Format('reports/acquisition/{}/acquisition-report.json', $.run.request_id)"
      }
    },
    "acquisitionReportHead": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:headObject",
      "Parameters": {
        "Bucket": "airline-bts-336805808138-us-east-2",
        "Key.$": "$.control.output.key"
